{
  "pluginAlias": "ZiroomHomebridgePlugin",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "homebridge-plugin-ziroom",
        "description": "The name of the plugin instance."
      },
      "account": {
        "title": "Account",
        "type": "string",
        "required": false,
        "description": "Your Ziroom account."
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": false,
        "description": "Your Ziroom password."
      },
      "token": {
        "title": "Token",
        "type": "string",
        "required": false,
        "description": "Your Ziroom token."
      },
      "hid": {
        "title": "HID",
        "type": "string",
        "required": false,
        "description": "Your Ziroom hid."
      },
      "detectorPollIntervalMinutes": {
        "title": "Detector Poll Interval (minutes)",
        "type": "number",
        "minimum": 0.5,
        "default": 0.5,
        "description": "How often gas and water detectors refresh their state from Ziroom (minimum 30 seconds)."
      },
      "lockPollIntervalMinutes": {
        "title": "Lock Battery Poll Interval (minutes)",
        "type": "integer",
        "minimum": 1,
        "default": 60,
        "description": "How often the smart lock battery level refreshes from Ziroom."
      }
    }
  }
}
